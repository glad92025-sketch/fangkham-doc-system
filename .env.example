APP_NAME="อบต.ฝางคำ - ระบบจัดเก็บเอกสาร"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Bangkok
APP_URL=http://localhost:8000

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# การตั้งค่าฐานข้อมูล (ใช้ SQLite สำหรับทดสอบ หรือ PostgreSQL/MySQL สำหรับใช้งานจริง)
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=fangkham_db
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Google Drive Configuration
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=storage/app/google-service-account.json
GOOGLE_DRIVE_SHARED_DRIVE_ID=
